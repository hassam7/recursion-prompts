---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProblems, siteUrl } from '../lib/problem-content.js';

const problems = await getProblems();
const title = 'Recursion Prompts - Practice Recursion with JavaScript';
const description = `Build recursive problem-solving skills with ${problems.length} challenges, JavaScript starter prompts, and browser-based test feedback.`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: 'Recursion Prompts',
  description,
  learningResourceType: 'Coding challenge collection',
  programmingLanguage: 'JavaScript',
  url: siteUrl('/'),
};
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <main class="site-shell">
    <header class="site-header">
      <a class="site-brand" href="/">Recursion Prompts</a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="/playground/">Practice</a>
        <a href="#challenges">Challenges</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="home-title">
      <div>
        <div class="eyebrow">Recursion practice in JavaScript</div>
        <h1 id="home-title">Practice recursion with JavaScript and real tests.</h1>
        <p class="hero-copy">
          Work through {problems.length} focused coding challenges. Read the prompt,
          write a recursive solution, and run the tests in your browser when you are ready.
        </p>
        <div class="action-row">
          <a class="button-link" href="/playground/">Open the playground</a>
          <a class="button-link secondary" href={`/problems/${problems[0].slug}/`}>Start with {problems[0].title}</a>
        </div>
      </div>

      <aside class="stat-panel" aria-label="Challenge count">
        <span class="stat-number">{problems.length}</span>
        <p>recursive thinking drills.</p>
      </aside>
    </section>

    <section id="challenges" aria-labelledby="challenges-title">
      <h2 id="challenges-title">Choose a recursion challenge</h2>
      <div class="problem-grid">
        {problems.map((problem) => (
          <a class="problem-link" href={`/problems/${problem.slug}/`}>
            <span>Problem {problem.num}</span>
            {problem.title}
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>